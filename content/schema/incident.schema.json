{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opsatlas.dev/schemas/incident.schema.json",
  "title": "IncidentContentFile",
  "description": "Schema for OpsAtlas incident content files stored in /content/incidents/",
  "type": "object",
  "required": [
    "slug", "title", "org", "incident_date", "summary", "impact",
    "failure_domain", "severity", "is_reconstruction", "skill_tags",
    "sources", "timeline", "causal_factors", "lessons"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "description": "URL-safe identifier", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "org": { "type": "string", "minLength": 1 },
    "incident_date": { "type": "string", "format": "date" },
    "summary": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "failure_domain": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "minLength": 1 },
    "is_reconstruction": { "type": "boolean" },
    "skill_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "At least one source citation required (Req 3.1)",
      "items": { "$ref": "#/definitions/IncidentSource" }
    },
    "timeline": { "type": "array", "items": { "$ref": "#/definitions/TimelineEvent" } },
    "causal_factors": { "type": "array", "items": { "$ref": "#/definitions/CausalFactor" } },
    "lessons": { "type": "array", "items": { "$ref": "#/definitions/Lesson" } }
  },
  "definitions": {
    "IncidentSource": {
      "type": "object",
      "required": ["publisher", "source_tier"],
      "additionalProperties": false,
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "bibliographic_ref": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string" },
        "source_tier": { "type": "string", "enum": ["tier1", "tier2", "tier3"] }
      }
    },
    "TimelineEvent": {
      "type": "object",
      "required": ["occurred_at", "tz_offset", "description", "confidence", "sequence_pos"],
      "additionalProperties": false,
      "properties": {
        "occurred_at": { "type": "string" },
        "tz_offset": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["fact", "inference", "teaching_simplification", "unknown"] },
        "source_ref": { "type": "string" },
        "sequence_pos": { "type": "integer", "minimum": 0 }
      }
    },
    "CausalFactor": {
      "type": "object",
      "required": ["factor_type", "description", "confidence"],
      "additionalProperties": false,
      "properties": {
        "factor_type": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["fact", "inference", "teaching_simplification", "unknown"] },
        "source_ref": { "type": "string" }
      }
    },
    "Lesson": {
      "type": "object",
      "required": ["category", "statement"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "recommended_control": { "type": "string" },
        "source_ref": { "type": "string" }
      }
    }
  }
}
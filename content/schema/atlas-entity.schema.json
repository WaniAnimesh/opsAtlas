{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atlas-entity.schema.json",
  "title": "Decision Atlas entity file (array of entities)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "type", "layer", "description", "tags", "difficulty", "status", "lastReviewed", "sections", "relations"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 1 },
      "type": {
        "enum": ["concept", "decision", "comparison", "technology", "pattern", "failure-pattern", "framework", "case-study", "review"]
      },
      "layer": { "type": "string", "minLength": 1 },
      "subcategory": { "type": "string" },
      "secondaryLayers": { "type": "array", "items": { "type": "string" } },
      "description": { "type": "string", "minLength": 1 },
      "question": { "type": "string" },
      "tags": { "type": "array", "items": { "type": "string" } },
      "aliases": { "type": "array", "items": { "type": "string" } },
      "problems": { "type": "array", "items": { "type": "string" } },
      "difficulty": { "enum": ["orientation", "decision", "operational"] },
      "status": { "enum": ["published", "draft"] },
      "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url"],
          "properties": {
            "title": { "type": "string" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "publisher": { "type": "string" }
          }
        }
      },
      "sections": {
        "type": "object",
        "propertyNames": {
          "enum": ["overview", "context", "assumptions", "challenge", "constraints", "facts", "causes", "progression", "warningSigns", "whenToUse", "whenNotToUse", "alternatives", "operations", "cost", "organization", "technicalImpact", "businessImpact", "organizationalImpact", "failureModes", "prevention", "recovery", "reasoning", "application", "examples", "limitations", "interpretation", "implementation", "lessons", "summary"]
        },
        "additionalProperties": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      },
      "tradeoffs": {
        "type": "object",
        "additionalProperties": false,
        "required": ["options", "rows"],
        "properties": {
          "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "values"],
              "properties": {
                "dimension": {
                  "enum": ["Cost", "Performance", "Reliability", "Scalability", "Complexity", "Security", "Operations", "Developer Experience", "Organizational Fit", "Flexibility"]
                },
                "values": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "guidance": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["option", "chooseWhen"],
          "properties": {
            "option": { "type": "string" },
            "chooseWhen": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "avoidWhen": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "criteria": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["area", "question", "healthy", "risk"],
          "properties": {
            "area": { "type": "string" },
            "question": { "type": "string" },
            "healthy": { "type": "string" },
            "risk": { "type": "string" },
            "explore": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "incidents": { "type": "array", "items": { "type": "string" } },
      "relations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "properties": {
            "type": {
              "enum": ["requires", "enables", "depends-on", "alternative-to", "precedes", "influences", "evaluates", "implements", "provides", "integrates-with", "competes-with", "replaces", "introduces-risk", "mitigates", "improves", "degrades", "requires-capability", "can-cause", "contributes-to", "amplifies", "prevents", "recovers-from", "prerequisite-for", "related-to", "deepens", "example-of"]
            },
            "target": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}

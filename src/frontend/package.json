{
  "name": "opsatlas-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "npm --prefix ../.. run build:search-index",

    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
